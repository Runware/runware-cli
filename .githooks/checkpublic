#!/bin/sh
# Runs tools/checkpublic, rebuilt into this worktree's git directory when its source
# changes. The git pre-push hook and the agent hooks in .claude/settings.json
# and .codex/hooks.json call it.
#
# Every failure exits 2: an agent hook blocks the tool call only on status 2
# (any other status lets it run unchecked), and git blocks the push on any
# non-zero status. The agent hooks pass every Bash command to the tool, which
# answers a command that cannot publish in a few milliseconds: a quick text
# filter here would let through forms the tool reads as publishing, such as a
# command name in a variable or in quotes.
set -u

fail() {
	echo "checkpublic: $1; blocked because nothing was checked" >&2
	exit 2
}

root=$(cd "$(dirname "$0")/.." && pwd) || fail "cannot find the repository"
gitdir=$(git -C "$root" rev-parse --path-format=absolute --git-dir) || fail "cannot find the git directory"
cache=$gitdir/checkpublic
bin=$cache/checkpublic

# unbuilt handles a hook call when there is no binary at all, so the agent
# can still fix the build. It tests only what a tool call could publish: the
# command of a Bash call, or the name and arguments of any other tool, less
# the fields that only describe the session or the call. A file tool (Edit,
# Read, ...) is let through by name: its path may well hold "github". A call
# with a word that could publish (gh, git, hub, push, an expansion, a GitHub
# tool, an escape that could hide one) is blocked; any other runs with a
# warning. JSON strings hold no raw line break, so the payload is joined into
# one line first, and a line continuation is joined as the shell would.
unbuilt() {
	payload=$(tr '\n' ' ')
	tool=$(printf '%s' "$payload" | sed -n -E 's/.*"tool_name"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)".*/\1/p')
	case $tool in
	Edit | MultiEdit | NotebookEdit | Read | Write | Glob | Grep)
		echo "checkpublic: warning: could not build tools/checkpublic ($1); $tool publishes nothing, so it runs unchecked. Run make setup to see the error." >&2
		exit 0
		;;
	Bash)
		text=$(printf '%s' "$payload" | sed -n -E 's/.*"command"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)".*/\1/p')
		[ -n "$text" ] || fail "could not build tools/checkpublic ($1), and found no command in the Bash call"
		;;
	*)
		text=$(printf '%s' "$payload" |
			sed -E 's/"(cwd|description|transcript_path|session_id|hook_event_name|permission_mode|tool_use_id|turn_id|model)"[[:space:]]*:[[:space:]]*"([^"\\]|\\.)*"//g')
		;;
	esac
	if printf '%s' "$text" | grep -q '\\u'; then
		fail "could not build tools/checkpublic ($1)"
	fi
	text=$(printf '%s' "$text" | sed -e 's/\\\\\\n//g' | tr -d "'\"\\\\")
	if printf '%s' "$text" | grep -Eiq 'gh|git|hub|push|[$`]'; then
		fail "could not build tools/checkpublic ($1)"
	fi
	echo "checkpublic: warning: could not build tools/checkpublic ($1), so this tool call was not checked; it runs because no GitHub write or git push was recognised in it. Run make setup to see the error." >&2
	exit 0
}

# A source that does not build must not block every agent tool call (the
# agent could not even run the build to see the error): the previous binary
# keeps checking, with a warning. Without any binary, only a tool call that
# could publish is blocked.
if [ ! -x "$bin" ] || [ -n "$(find "$root/tools/checkpublic" "$root/go.mod" -newer "$bin" 2>/dev/null | head -n 1)" ]; then
	mkdir -p "$cache" || fail "cannot create $cache"
	if (cd "$root" && go build -o "$bin.new" ./tools/checkpublic) && mv -f "$bin.new" "$bin"; then
		:
	elif [ -x "$bin" ]; then
		rm -f "$bin.new"
		echo "checkpublic: warning: tools/checkpublic does not build; checking with the previous build" >&2
	elif [ "${1:-}" = hook ]; then
		unbuilt "no previous build"
	else
		fail "could not build tools/checkpublic"
	fi
fi

status=0
"$bin" "$@" || status=$?
case ${1:-}:$status in
*:0) ;;
hook:2) exit 2 ;;
hook:*) fail "tools/checkpublic failed with status $status" ;;
*) exit "$status" ;;
esac
