{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.githooks/checkpublic hook",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "^mcp__.*github",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.githooks/checkpublic hook",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
